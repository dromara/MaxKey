{
  "name": "maxkey",
  "version": "4.2.X",
  "description": "Leading-Edge IAM Identity and Access Management",
  "author": "MaxKey <support@maxsso.net>",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/dromara/MaxKey"
  },
  "bugs": {
    "url": "https://gitee.com/dromara/MaxKey/issues"
  },
  "homepage": "https://www.maxkey.top",
  "license": "MaxKey",
  "angular_version": "22.2.0",
  "keywords": [
    "maxkey",
    "delon",
    "antd",
    "ng-zorro-antd",
    "angular",
    "component",
    "scaffold"
  ],
  "scripts": {
    "prepare": "husky install",
    "start": "ng s -o  --serve-path=/maxkey/ --port=8527 ",
    "hmr": "ng s -o --hmr",
    "build": "ng b",
    "build:prod": "ng b --configuration production --base-href /maxkey/",
    "analyze": "ng b --source-map",
    "analyze:view": "source-map-explorer dist/**/*.js --no-border-checks",
    "lint": "npm run lint:ts && npm run lint:style",
    "lint:ts": "ng lint",
    "lint:style": "npx stylelint 'src/**/*.less'",
    "test": "ng test",
    "test-coverage": "ng test -c coverage --coverage --watch=false",
    "color-less": "ng-alain-plugin-theme -t=colorLess",
    "theme": "ng-alain-plugin-theme -t=themeCss",
    "icon": "ng g ng-alain:plugin icon"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@delon/abc": "^22.1.1",
    "@delon/acl": "^22.1.1",
    "@delon/auth": "^22.1.1",
    "@delon/cache": "^22.1.1",
    "@delon/chart": "^22.1.1",
    "@delon/form": "^22.1.1",
    "@delon/mock": "^22.1.1",
    "@delon/theme": "^22.1.1",
    "@delon/util": "^22.1.1",
    "@ng-util/monaco-editor": "^22.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "crypto-js": "^4.1.1",
    "date-fns": "^4.4.0",
    "ng-zorro-antd": "^22.1.1",
    "ngx-cookie-service": "^22.0.0",
    "ngx-tinymce": "^22.0.0",
    "rxjs": "~7.8.0",
    "screenfull": "^6.0.2",
    "sm-crypto": "^0.5.7",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@delon/testing": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.62.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.3",
    "@types/sm-crypto": "^0.3.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/utils": "^8.69.0",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "ng-alain": "^22.1.1",
    "ng-alain-plugin-theme": "^18.0.0",
    "prettier": "^3.9.9",
    "source-map-explorer": "^2.5.3",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "uuid": "^14.0.2",
    "vite": "^8.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "core-js": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "unrs-resolver": true
  },
  "lint-staged": {
    "(src)/**/*.{html,ts}": [
      "eslint --cache"
    ],
    "(src)/**/*.less": [
      "npm run lint:style"
    ]
  },
  "packageManager": "pnpm@12.6.0"
}
